# Copy this file to .env and add your server-side API key.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional commercial catalog adapter. Uncomment and set values supplied by your provider.
# CATALOG_PROVIDER=partstech
# CATALOG_API_URL=provider_endpoint_here
# CATALOG_API_KEY=provider_key_here

# Affiliate tracking (so you get paid on clicks/purchases)
# Join eBay Partner Network → get your Campaign ID (campid)
AFFILIATE_EBAY_CAMPID=
# Join Amazon Associates → your tag ends in -20 (e.g. yourname-20)
AFFILIATE_AMAZON_TAG=
# RockAuto affiliate (if available; often via Impact or their program)
AFFILIATE_ROCKAUTO=

# PORT=3000
# Public HTTPS URL used by the packaged mobile app, not localhost.
# MOBILE_API_URL=https://api.example.com
